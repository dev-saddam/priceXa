# ==============================================================================
# PriceXa Platform Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Find these in Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Inngest Serverless Background Workers (Crawlers, Auto-Matcher, 2x/Day Cron)
# ------------------------------------------------------------------------------
# Create a free account at https://inngest.com
# When deploying to Vercel, Inngest automatically connects to your app via /api/inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ------------------------------------------------------------------------------
# 3. Zyte API Configuration (Anti-Bot Bypass & Automated AI E-Commerce Scraping)
# ------------------------------------------------------------------------------
# Get your API key at https://app.zyte.com/
# Powers residential IP rotation, Google/DDG/Bing anti-bot bypass, and AI price extraction
ZYTE_API_KEY=your-zyte-api-key

# ------------------------------------------------------------------------------
# 4. Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
